#!/usr/bin/env sh
# yabai — no tiling at all; yabai only handles space focus (option + num via
# skhd) and focus-follows-mouse. Everything else is plain floating macOS.
# Running WITHOUT the scripting addition (SIP enabled).

yabai="$HOME/.local/bin/yabai"

# ---- no tiling: all windows are floating ----
"$yabai" -m config layout float

# ---- focus follows mouse: 'autofocus' focuses without raising; use
# 'autoraise' if you want hovered windows raised too ----
"$yabai" -m config focus_follows_mouse    autofocus
"$yabai" -m config mouse_follows_focus    off

# ---- native menu bar: invisible (replaced by sketchybar) ----
"$yabai" -m config menubar_opacity        0.0

# ---- jankyborders (still draws borders around floating windows) ----
pkill -x borders >/dev/null 2>&1
"$HOME/.local/bin/borders" &

echo "yabai configuration loaded.."
