;;; init.el --- Personal configuration -*- lexical-binding: t; -*-

;;; Code:
(require 'package)
(setq ring-bell-function #'ignore)
(add-to-list 'package-archives
	     '("melpa" . "https://melpa.org/packages/")
	     t)
(package-initialize)
(savehist-mode 1)
(save-place-mode 1)
(global-auto-revert-mode 1)
;; better trackpad scrolling
(when (fboundp 'pixel-scroll-precision-mode)
  (pixel-scroll-precision-mode 1))


(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(package-selected-packages
   '(apheleia cape consult consult-lsp corfu dashboard evil-collection
	      evil-commentary evil-surround flycheck gruvbox-theme
	      haskell-mode helpful leuven-theme lsp-haskell
	      lsp-pyright magit marginalia orderless projectile rg
	      rust-mode vertico yasnippet)))
(custom-set-faces
 ;; custom-set-faces was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(evil-goggles-change-face ((t (:inherit diff-removed))))
 '(evil-goggles-delete-face ((t (:inherit diff-removed))))
 '(evil-goggles-paste-face ((t (:inherit diff-added))))
 '(evil-goggles-undo-redo-add-face ((t (:inherit diff-added))))
 '(evil-goggles-undo-redo-change-face ((t (:inherit diff-changed))))
 '(evil-goggles-undo-redo-remove-face ((t (:inherit diff-removed))))
 '(evil-goggles-yank-face ((t (:inherit diff-changed)))))


;; (load-theme 'leuven-dark t)
(use-package gruvbox-theme
  :ensure t
  :config
  (load-theme 'gruvbox-dark-medium t))

(use-package dired
  :ensure nil
  :custom
  (insert-directory-program "/opt/homebrew/bin/gls")
  (dired-use-ls-dired t))

(use-package evil
  :ensure t
  :init
  ;; workaround emacs 31 evil bug
  (defvar evil-mode-buffers nil)
  (setq evil-want-keybinding nil
        evil-want-C-u-scroll t
        evil-want-C-i-jump t
        evil-ex-search-highlight-all t
        evil-ex-search-persistent-highlight t
        evil-ex-search-incremental t
	evil-undo-system 'undo-redo
        evil-ex-hl-update-delay 0.2
        scroll-margin 7
        scroll-conservatively 101)
  :config
  (evil-mode 1)
  (evil-set-leader 'normal (kbd "SPC"))
  (evil-select-search-module 'evil-search-module 'evil-search))

(use-package evil-goggles
  :ensure t
  :config
  (evil-goggles-mode)

  (evil-goggles-use-diff-faces))

(use-package projectile
  :ensure t
  :config
  (projectile-mode 1)
  :bind
  ("s-p" . projectile-command-map)
  :init
  (setq projectile-session-autosave t))

(use-package magit
  :ensure t
  :bind ("C-x g" . magit-status))

(use-package diff-hl
  :ensure t
  :demand t
  :custom
  (diff-hl-side 'left)
  (diff-hl-show-staged-changes t)
  :hook
  (magit-post-refresh . diff-hl-magit-post-refresh)
  :config
  (global-diff-hl-mode 1)
  (diff-hl-flydiff-mode 1))

(use-package evil-collection
  :ensure t
  :after evil
  :config
  (evil-collection-init))

(use-package evil-commentary
  :ensure t
  :after evil
  :init
  (evil-commentary-mode))

(use-package evil-surround
  :ensure t
  :after (evil evil-collection)
  :config
  (global-evil-surround-mode 1))

(use-package vertico
  :ensure t
  :init
  (vertico-mode))

(use-package orderless
  :ensure t
  :custom
  (completion-styles '(orderless basic))
  (completion-category-overrides '((file (styles partial-completion))))
  (completion-pcm-leading-wildcard t))

(use-package marginalia
  :ensure t
  :init
  (marginalia-mode 1))

(use-package consult
  :ensure t
  :bind
  (("C-s" . consult-line)
   ("C-x b" . consult-buffer)
   ("C-c r" . consult-recent-file))
  :after evil
  :config
  (evil-define-key 'normal 'global
    (kbd "<leader>sg") #'consult-ripgrep
    (kbd "<leader>ss") #'consult-imenu)
  )

(use-package corfu
  :ensure t
  :init
  (global-corfu-mode))

(use-package cape
  :ensure t
  :init
  (add-to-list 'completion-at-point-functions
               #'cape-file))

(use-package flycheck
  :ensure t
  :custom
  (flycheck-annotate-current-line-style 'eol)
  (flycheck-annotate-other-lines-style 'eol)
  (flycheck-indication-mode nil)
  ;; on cursor line
  (flycheck-annotate-levels t)
  (flycheck-annotate-current-line-levels t)
  ;; on other lines
  (flycheck-annotate-other-lines-levels '(error))
  :config
  (global-flycheck-mode 1)
  (global-flycheck-annotate-mode 1))
(use-package yasnippet
  :ensure t
  :init
  (yas-global-mode 1))

(use-package lsp-mode
  ;; deferred is better perf wise
  :commands (lsp lsp-deferred)
  :ensure t
  :init
  (setq
   lsp-keymap-prefix "C-c l"
   lsp-completion-provider :capf
   lsp-diagnostics-provider :flycheck
   lsp-enable-snippet t
   lsp-enable-symbol-highlighting t
   lsp-rust-analyzer-lens-implementations-enable nil
   lsp-enable-semantic-highlighting t
   lsp-headerline-breadcrumb-enable t
   lsp-modeline-code-actions-enable t
   )
  :hook
  ((c-mode . lsp-deferred)
   (c++-mode . lsp-deferred)
   (c-ts-mode . lsp-deferred)
   (c++-ts-mode . lsp-deferred)
   (rust-mode . lsp-deferred)
   (rust-ts-mode . lsp-deferred)
   (haskell-mode . lsp-deferred)
   (haskell-literate-mode . lsp-deferred)))

(use-package rust-mode
  :ensure t
  :mode "\\.rs\\'")

(use-package haskell-mode
  :ensure t
  :mode "\\.hs\\'")

(use-package lsp-haskell
  :ensure t)


(use-package lsp-pyright
  :ensure t
  :custom
  (lsp-pyright-langserver-command "basedpyright")
  :hook
  ((python-mode python-ts-mode)
   . (lambda ()
       (require 'lsp-pyright)
       (lsp-deferred))))

(use-package rg
  :ensure t
  :defer t)

(use-package tab-bar
  :ensure nil
  :demand t
  :bind
  ("s-t" . tab-new)
  :custom
  (tab-bar-show 1)
  (tab-bar-select-tab-modifiers '(super))
  (tab-bar-tab-hints t)
  :config
  (tab-bar-mode 1)
  (tab-bar-history-mode 1))


(use-package org
  :ensure nil
  :bind
  (("C-c a" . org-agenda)
   ("C-c c" . org-capture))
  :custom
  (org-directory "~/org/")
  (org-agenda-files '("~/org/"))
  (org-startup-indented t)
  (org-hide-emphasis-markers t)
  :config
  (setq org-capture-templates
        '(("n" "Notes" entry
           (file "~/org/notes.org")
           "* %?\nCaptured: %u")

          ("t" "Tasks" entry
           (file "~/org/todo.org")
           "* TODO %?\nCaptured: %u")

          ("r" "Refile" entry
           (file "~/org/refile.org")
           "* %? :refile:\nCaptured: %u")

          ("l" "Links" entry
           (file "~/org/links.org")
           "* [[%(or (gui-get-selection 'CLIPBOARD 'STRING) \"\"][%^{Description}]] :%^{Tag|blog|article|tutorial|reddit|video|problem}:\nSaved: %u"))))

(use-package org-modern
  :ensure t
  :after org
  :custom
  (org-modern-fold-stars '(("\u25b8" . "\u25be")))
  :config
  (global-org-modern-mode 1))

(use-package lsp-ui
  :ensure t
  :after lsp-mode
  :custom
  (lsp-ui-doc-enable t)
  (lsp-ui-doc-use-childframe t)
  (lsp-ui-doc-position 'at-point)
  (lsp-ui-doc-show-with-cursor nil)
  (lsp-ui-doc-show-with-mouse nil)
  (lsp-ui-doc-max-width 80)
  (lsp-ui-doc-max-height 20)
  (lsp-ui-doc-border "#665c54")
  (lsp-ui-sideline-enable nil)
  :custom-face
  (lsp-ui-doc-background ((t (:background "#282828"))))
  :config
  (evil-define-key 'normal lsp-ui-doc-frame-mode-map
    (kbd "q") #'lsp-ui-doc-hide
    (kbd "<escape>") #'lsp-ui-doc-hide))

(use-package ghostel
  :ensure t
  :bind ("C-c t" . ghostel))

(use-package evil-ghostel
  :ensure t
  :after (ghostel evil)
  :hook (ghostel-mode . evil-ghostel-mode))

(use-package xwidget
  :ensure nil
  :bind ("C-c b" . xwidget-webkit-browse-url))

(use-package apheleia
  :ensure t
  :config
  (apheleia-global-mode +1))


;; Recent files (built-in)
(use-package recentf
  :ensure nil
  :custom
  (recentf-max-saved-items 200)
  :config
  (recentf-mode 1))

;; Startup dashboard
(use-package dashboard
  :ensure t
  :custom
  (dashboard-startup-banner 'logo)
  (dashboard-center-content t)
  (dashboard-projects-backend 'projectile)
  (dashboard-items
   '((recents . 8)
     (projects . 5)
     (agenda . 5)))
  :config
  (dashboard-setup-startup-hook))

(use-package embark-consult
  :ensure t)

(use-package embark
  :ensure t
  :bind
  (("C-." . embark-act)
   ("C-;" . embark-dwim)
   ("C-h B" . embark-bindings))
  :init
  (setq prefix-help-command #'embark-prefix-help-command))

(use-package helpful
  :ensure t
  :bind
  (("C-h f" . helpful-callable)
   ("C-h v" . helpful-variable)
   ("C-h k" . helpful-key)
   ("C-h x" . helpful-command)
   ("C-c C-d" . helpful-at-point)
   ("C-h F" . helpful-function))
  )

(evil-define-key 'normal 'lsp-mode
  (kbd "gd") #'lsp-find-definition
  (kbd "gr") #'lsp-find-references
  (kbd "gi") #'lsp-find-implementation
  (kbd "gD") #'lsp-find-declaration)

(evil-define-key 'normal 'global
  (kbd "<leader>q")  #'flycheck-list-errors
  (kbd "<leader>ss") #'consult-imenu
  (kbd "<leader>sS") #'xref-find-apropos
  (kbd "<leader>ca") #'lsp-execute-code-action)

;; custom function
(defun my/evil-scroll-up-center ()
  "Center C-u."
  (interactive)
  (call-interactively #'evil-scroll-up)
  (recenter))

(defun my/evil-scroll-down-center ()
  "Center C-d."
  (interactive)
  (call-interactively #'evil-scroll-down)
  (recenter))

(defun my/vsplit-focus ()
  "Focus on C-w v window."
  (interactive)
  (select-window (split-window-right)))

(defun my/hsplit-focus ()
  "Focus on C-w s window."
  (interactive)
  (select-window (split-window-below)))
;; Keybinds
(define-key evil-normal-state-map (kbd "-") #'dired-jump)
(define-key evil-normal-state-map (kbd "D") (kbd "dd"))
(define-key evil-normal-state-map (kbd "Y") (kbd "yy"))
(define-key evil-normal-state-map (kbd "C-u") #'my/evil-scroll-up-center)
(define-key evil-normal-state-map (kbd "C-d") #'my/evil-scroll-down-center)
(define-key evil-normal-state-map (kbd "K") #'lsp-ui-doc-show)
(define-key evil-window-map (kbd "v") #'my/vsplit-focus)
(define-key evil-window-map (kbd "s") #'my/hsplit-focus)
(define-key evil-normal-state-map (kbd "<escape>") nil)
(define-key evil-normal-state-map
	    (kbd "<escape> <escape>") #'evil-ex-nohighlight)
;; TODO: make a keybind to reload config
(set-face-attribute 'default nil :height 210 :family "JetBrains Mono")
(electric-pair-mode 1)
(use-package which-key
  :ensure nil
  :init
  (which-key-mode 1)
  :custom
  (which-key-idle-delay 0.5)
  (which-key-side-window-location 'bottom))
(setq display-line-numbers-type 'relative)

(add-hook 'prog-mode-hook
          #'display-line-numbers-mode)
(global-display-line-numbers-mode 1)
