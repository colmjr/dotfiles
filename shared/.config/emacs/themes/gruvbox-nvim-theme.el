;;; gruvbox-nvim-theme.el --- Match ellisonleao/gruvbox.nvim -*- lexical-binding: t; -*-

;; A standalone theme for vanilla Emacs, with no package dependencies.
;; Palette and highlight mappings follow the locally installed gruvbox.nvim:
;; dark background, medium contrast, opaque, default bold/italic settings.
;; https://github.com/ellisonleao/gruvbox.nvim

;;; Code:

(require 'cl-lib)

(deftheme gruvbox-nvim
  "Gruvbox dark medium with Neovim's syntax and UI color mappings.")

(let* ((bg0 "#282828") (bg1 "#3c3836") (bg2 "#504945")
       (bg3 "#665c54") (bg4 "#7c6f64")
       (fg1 "#ebdbb2") (fg2 "#d5c4a1")
       (fg3 "#bdae93") (fg4 "#a89984") (gray "#928374")
       (red "#fb4934") (green "#b8bb26") (yellow "#fabd2f")
       (blue "#83a598") (purple "#d3869b") (aqua "#8ec07c")
       (orange "#fe8019")
       (diff-red "#722529") (diff-green "#62693e") (diff-aqua "#49503b"))
  (custom-theme-set-faces
   'gruvbox-nvim
   ;; Editor UI: Normal, CursorLine, Visual, Search, StatusLine, TabLine.
   `(default ((t (:foreground ,fg1 :background ,bg0))))
   `(cursor ((t (:background ,fg1))))
   `(fringe ((t (:foreground ,fg4 :background ,bg1))))
   `(vertical-border ((t (:foreground ,bg3 :background ,bg0))))
   `(window-divider ((t (:foreground ,bg3))))
   `(window-divider-first-pixel ((t (:foreground ,bg3))))
   `(window-divider-last-pixel ((t (:foreground ,bg3))))
   `(internal-border ((t (:background ,bg3))))
   `(child-frame-border ((t (:background ,bg3))))
   `(line-number ((t (:foreground ,bg4 :background ,bg0))))
   `(line-number-current-line ((t (:foreground ,yellow :background ,bg1 :weight normal))))
   `(hl-line ((t (:background ,bg1 :extend t))))
   `(region ((t (:background ,bg3 :extend t))))
   `(secondary-selection ((t (:background ,bg2 :extend t))))
   `(highlight ((t (:background ,bg1))))
   `(trailing-whitespace ((t (:background ,red))))
   `(whitespace-space ((t (:foreground ,bg2))))
   `(whitespace-tab ((t (:foreground ,bg2))))
   `(whitespace-newline ((t (:foreground ,bg2))))
   `(fill-column-indicator ((t (:foreground ,bg1))))
   `(shadow ((t (:foreground ,gray))))
   `(minibuffer-prompt ((t (:foreground ,red :weight normal))))
   `(link ((t (:foreground ,blue :underline t))))
   `(link-visited ((t (:foreground ,purple :underline t))))
   `(button ((t (:foreground ,blue :underline t))))
   `(header-line ((t (:foreground ,fg4 :background ,bg0 :box nil))))
   `(mode-line ((t (:foreground ,fg1 :background ,bg2 :box nil))))
   `(mode-line-inactive ((t (:foreground ,fg4 :background ,bg1 :box nil))))
   `(mode-line-buffer-id ((t (:foreground ,fg1 :weight bold))))
   `(mode-line-emphasis ((t (:foreground ,yellow :weight bold))))
   `(tab-bar ((t (:foreground ,bg4 :background ,bg1))))
   `(tab-bar-tab ((t (:foreground ,green :background ,bg1 :box nil :weight normal))))
   `(tab-bar-tab-inactive ((t (:foreground ,bg4 :background ,bg1 :box nil))))
   `(tab-line ((t (:foreground ,bg4 :background ,bg1))))
   `(tab-line-tab ((t (:foreground ,green :background ,bg1))))
   `(tab-line-tab-current ((t (:foreground ,green :background ,bg1))))
   `(tab-line-tab-inactive ((t (:foreground ,bg4 :background ,bg1))))
   `(tooltip ((t (:foreground ,fg1 :background ,bg1))))
   `(isearch ((t (:foreground ,bg0 :background ,orange :weight normal))))
   `(lazy-highlight ((t (:foreground ,bg0 :background ,yellow))))
   `(match ((t (:foreground ,bg0 :background ,yellow))))
   ;; LSP reference results preserve syntax foregrounds over this background.
   `(xref-match ((t (:inherit nil :background ,bg1 :weight bold))))
   `(isearch-fail ((t (:foreground ,bg0 :background ,red))))
   `(show-paren-match ((t (:background ,bg3 :weight bold))))
   `(show-paren-mismatch ((t (:foreground ,bg0 :background ,red :weight bold))))
   `(success ((t (:foreground ,green :weight normal))))
   `(warning ((t (:foreground ,yellow :weight normal))))
   `(error ((t (:foreground ,red :weight normal))))
   ;; Syntax: tree-sitter variables are cream; members/parameters are blue.
   ;; Set weight and slant explicitly to avoid inherited Emacs defaults.
   `(font-lock-comment-face ((t (:foreground ,gray :slant italic :weight normal))))
   `(font-lock-comment-delimiter-face ((t (:inherit font-lock-comment-face))))
   `(font-lock-doc-face ((t (:inherit font-lock-comment-face))))
   `(font-lock-doc-markup-face ((t (:foreground ,purple))))
   `(font-lock-string-face ((t (:foreground ,green :slant italic :weight normal))))
   `(font-lock-keyword-face ((t (:foreground ,red :weight normal))))
   `(font-lock-function-name-face ((t (:foreground ,green :weight bold))))
   `(font-lock-function-call-face ((t (:inherit font-lock-function-name-face))))
   `(font-lock-variable-name-face ((t (:foreground ,fg1 :weight normal))))
   `(font-lock-variable-use-face ((t (:inherit font-lock-variable-name-face))))
   `(font-lock-type-face ((t (:foreground ,yellow :weight normal))))
   `(font-lock-constant-face ((t (:foreground ,purple :weight normal))))
   `(font-lock-number-face ((t (:foreground ,purple))))
   `(font-lock-builtin-face ((t (:foreground ,orange :weight normal))))
   `(font-lock-preprocessor-face ((t (:foreground ,aqua :weight normal))))
   `(font-lock-negation-char-face ((t (:foreground ,orange))))
   `(font-lock-operator-face ((t (:foreground ,orange :slant normal))))
   `(font-lock-punctuation-face ((t (:foreground ,orange))))
   `(font-lock-delimiter-face ((t (:foreground ,orange))))
   `(font-lock-bracket-face ((t (:foreground ,orange))))
   `(font-lock-property-name-face ((t (:foreground ,blue))))
   `(font-lock-property-use-face ((t (:inherit font-lock-property-name-face))))
   `(font-lock-escape-face ((t (:foreground ,orange :slant normal))))
   `(font-lock-regexp-grouping-backslash ((t (:foreground ,orange))))
   `(font-lock-regexp-grouping-construct ((t (:foreground ,orange))))
   `(font-lock-warning-face ((t (:foreground ,red :weight bold))))
   ;; lsp-mode semantic tokens must agree with syntax highlighting.
   `(lsp-face-semhl-variable ((t (:inherit font-lock-variable-name-face))))
   `(lsp-face-semhl-namespace ((t (:foreground ,fg1 :weight normal))))
   `(lsp-face-semhl-parameter ((t (:foreground ,blue :weight normal))))
   `(lsp-face-semhl-member ((t (:foreground ,blue :weight normal))))
   `(lsp-face-semhl-property ((t (:foreground ,blue :weight normal))))
   `(lsp-face-semhl-event ((t (:foreground ,blue :weight normal))))
   `(lsp-face-semhl-function ((t (:inherit font-lock-function-name-face))))
   `(lsp-face-semhl-method ((t (:inherit font-lock-function-name-face))))
   `(lsp-face-semhl-type ((t (:inherit font-lock-type-face))))
   `(lsp-face-semhl-class ((t (:inherit font-lock-type-face))))
   `(lsp-face-semhl-struct ((t (:inherit font-lock-type-face))))
   `(lsp-face-semhl-enum ((t (:inherit font-lock-type-face))))
   `(lsp-face-semhl-interface ((t (:foreground ,orange :weight normal))))
   `(lsp-face-semhl-type-parameter ((t (:inherit font-lock-type-face))))
   `(lsp-face-semhl-constant ((t (:inherit font-lock-constant-face))))
   `(lsp-face-semhl-enum-member ((t (:inherit font-lock-constant-face))))
   `(lsp-face-semhl-number ((t (:inherit font-lock-constant-face))))
   `(lsp-face-semhl-keyword ((t (:inherit font-lock-keyword-face))))
   `(lsp-face-semhl-modifier ((t (:foreground ,orange :weight normal))))
   `(lsp-face-semhl-operator ((t (:inherit font-lock-operator-face))))
   `(lsp-face-semhl-macro ((t (:inherit font-lock-preprocessor-face))))
   `(lsp-face-semhl-decorator ((t (:inherit font-lock-preprocessor-face))))
   `(lsp-face-semhl-string ((t (:inherit font-lock-string-face))))
   `(lsp-face-semhl-regexp ((t (:inherit font-lock-string-face))))
   `(lsp-face-semhl-comment ((t (:inherit font-lock-comment-face))))
   `(lsp-face-semhl-label ((t (:foreground ,red))))
   `(lsp-face-semhl-deprecated ((t (:strike-through t))))
   ;; These modifiers should not recolor or embolden every declaration.
   '(lsp-face-semhl-definition ((t (:inherit nil))))
   '(lsp-face-semhl-implementation ((t (:inherit nil))))
   '(lsp-face-semhl-static ((t (:inherit nil))))
   '(lsp-rust-analyzer-mutable-modifier-face ((t (:underline nil))))
   `(lsp-face-semhl-default-library ((t (:foreground ,orange))))
   `(lsp-face-highlight-textual ((t (:foreground ,yellow :weight bold))))
   `(lsp-face-highlight-read ((t (:foreground ,yellow :weight bold))))
   `(lsp-face-highlight-write ((t (:foreground ,orange :weight bold))))
   `(lsp-face-highlight-references ((t (:background ,bg3))))
   `(lsp-lens-face ((t (:foreground ,gray))))
   `(lsp-headerline-breadcrumb-path-face ((t (:foreground ,gray))))
   `(lsp-headerline-breadcrumb-symbols-face ((t (:foreground ,fg4))))
   `(lsp-ui-doc-background ((t (:background ,bg1))))
   `(lsp-ui-doc-header ((t (:foreground ,aqua :background ,bg2))))
   ;; Language-specific faces which otherwise override the base palette.
   `(rust-unsafe ((t (:foreground ,red))))
   `(rust-question-mark ((t (:foreground ,orange))))
   `(rust-ampersand-face ((t (:foreground ,orange))))
   `(rust-builtin-formatting-macro ((t (:foreground ,aqua))))
   `(rust-string-interpolation ((t (:foreground ,orange :slant normal))))
   `(haskell-keyword-face ((t (:inherit font-lock-keyword-face))))
   `(haskell-type-face ((t (:inherit font-lock-type-face))))
   `(haskell-constructor-face ((t (:foreground ,orange))))
   `(haskell-definition-face ((t (:inherit font-lock-function-name-face))))
   `(haskell-operator-face ((t (:foreground ,orange))))
   `(haskell-pragma-face ((t (:foreground ,aqua))))
   ;; Completion: Pmenu/PmenuSel, Telescope selection and matching.
   `(completions-common-part ((t (:foreground ,yellow :weight bold))))
   `(completions-first-difference ((t (:foreground ,orange))))
   `(completions-annotations ((t (:foreground ,gray))))
   `(completions-highlight ((t (:foreground ,bg2 :background ,blue :weight bold))))
   `(vertico-current ((t (:background ,bg1 :extend t))))
   `(vertico-group-title ((t (:foreground ,yellow :weight bold))))
   `(vertico-group-separator ((t (:foreground ,bg3 :strike-through t))))
   `(corfu-default ((t (:foreground ,fg1 :background ,bg2))))
   `(corfu-current ((t (:foreground ,bg2 :background ,blue :weight bold))))
   `(corfu-border ((t (:background ,bg3))))
   `(corfu-bar ((t (:background ,bg4))))
   `(corfu-annotations ((t (:foreground ,gray))))
   `(orderless-match-face-0 ((t (:foreground ,orange :weight bold))))
   `(orderless-match-face-1 ((t (:foreground ,blue :weight bold))))
   `(orderless-match-face-2 ((t (:foreground ,aqua :weight bold))))
   `(orderless-match-face-3 ((t (:foreground ,purple :weight bold))))
   `(consult-preview-line ((t (:background ,bg1 :extend t))))
   `(consult-highlight-match ((t (:foreground ,orange :weight bold))))
   `(marginalia-documentation ((t (:foreground ,gray))))
   `(marginalia-file-priv-dir ((t (:foreground ,green :weight bold))))
   `(which-key-key-face ((t (:foreground ,orange))))
   `(which-key-group-description-face ((t (:foreground ,aqua))))
   `(which-key-command-description-face ((t (:foreground ,fg1))))
   `(which-key-separator-face ((t (:foreground ,gray))))
   ;; Diagnostics: same colored undercurls and virtual text as Neovim.
   `(flycheck-error ((t (:underline (:style wave :color ,red)))))
   `(flycheck-warning ((t (:underline (:style wave :color ,yellow)))))
   `(flycheck-info ((t (:underline (:style wave :color ,blue)))))
   `(flycheck-fringe-error ((t (:foreground ,red :background ,bg1))))
   `(flycheck-fringe-warning ((t (:foreground ,yellow :background ,bg1))))
   `(flycheck-fringe-info ((t (:foreground ,blue :background ,bg1))))
   `(flycheck-annotate-error ((t (:foreground ,red))))
   `(flycheck-annotate-warning ((t (:foreground ,yellow))))
   `(flycheck-annotate-info ((t (:foreground ,blue))))
   `(flycheck-annotate-error-background ((t (:background ,diff-red :extend t))))
   `(flycheck-annotate-warning-background ((t (:background ,bg1 :extend t))))
   `(flycheck-annotate-info-background ((t (:background ,bg1 :extend t))))
   `(flymake-error ((t (:underline (:style wave :color ,red)))))
   `(flymake-warning ((t (:underline (:style wave :color ,yellow)))))
   `(flymake-note ((t (:underline (:style wave :color ,blue)))))
   `(flyspell-incorrect ((t (:underline (:style wave :color ,red)))))
   `(flyspell-duplicate ((t (:underline (:style wave :color ,purple)))))
   `(compilation-error ((t (:foreground ,red))))
   `(compilation-warning ((t (:foreground ,yellow))))
   `(compilation-info ((t (:foreground ,blue))))
   ;; DiffAdd/DiffDelete/DiffChange, GitSigns, and Magit.
   `(diff-added ((t (:foreground ,fg1 :background ,diff-green :extend t))))
   `(diff-removed ((t (:foreground ,fg1 :background ,diff-red :extend t))))
   `(diff-changed ((t (:foreground ,fg1 :background ,diff-aqua :extend t))))
   `(diff-refine-added ((t (:foreground ,bg0 :background ,yellow))))
   `(diff-refine-removed ((t (:foreground ,bg0 :background ,orange))))
   `(diff-refine-changed ((t (:foreground ,bg0 :background ,yellow))))
   `(diff-header ((t (:foreground ,orange :background ,bg1))))
   `(diff-file-header ((t (:foreground ,yellow :background ,bg1 :weight bold))))
   `(diff-hunk-header ((t (:foreground ,blue :background ,bg1))))
   `(diff-hl-insert ((t (:foreground ,green :background ,bg1))))
   `(diff-hl-delete ((t (:foreground ,red :background ,bg1))))
   `(diff-hl-change ((t (:foreground ,orange :background ,bg1))))
   `(magit-section-heading ((t (:foreground ,yellow :weight bold))))
   `(magit-section-highlight ((t (:background ,bg1 :extend t))))
   `(magit-branch-local ((t (:foreground ,aqua :weight bold))))
   `(magit-branch-remote ((t (:foreground ,green))))
   `(magit-hash ((t (:foreground ,gray))))
   `(magit-diff-added ((t (:inherit diff-added))))
   `(magit-diff-added-highlight ((t (:inherit diff-added))))
   `(magit-diff-removed ((t (:inherit diff-removed))))
   `(magit-diff-removed-highlight ((t (:inherit diff-removed))))
   `(magit-diff-context ((t (:foreground ,fg3 :background ,bg0 :extend t))))
   `(magit-diff-context-highlight ((t (:foreground ,fg1 :background ,bg1 :extend t))))
   `(magit-diff-hunk-heading ((t (:foreground ,blue :background ,bg1 :extend t))))
   `(magit-diff-hunk-heading-highlight ((t (:foreground ,blue :background ,bg2 :extend t))))
   `(magit-diff-file-heading ((t (:foreground ,yellow :weight bold))))
   `(magit-diffstat-added ((t (:foreground ,green))))
   `(magit-diffstat-removed ((t (:foreground ,red))))
   ;; Org follows @markup: green headings, not Emacs's rainbow headings.
   `(org-document-title ((t (:foreground ,green :weight bold :height 1.0))))
   `(org-document-info ((t (:foreground ,fg2))))
   `(org-level-1 ((t (:foreground ,green :weight bold :height 1.0))))
   '(org-level-2 ((t (:inherit org-level-1))))
   '(org-level-3 ((t (:inherit org-level-1))))
   '(org-level-4 ((t (:inherit org-level-1))))
   '(org-level-5 ((t (:inherit org-level-1))))
   '(org-level-6 ((t (:inherit org-level-1))))
   '(org-level-7 ((t (:inherit org-level-1))))
   '(org-level-8 ((t (:inherit org-level-1))))
   `(org-todo ((t (:foreground ,bg0 :background ,yellow :weight bold))))
   `(org-done ((t (:foreground ,orange :weight bold))))
   `(org-headline-done ((t (:foreground ,gray))))
   `(org-link ((t (:inherit link))))
   `(org-code ((t (:foreground ,green :slant italic))))
   `(org-verbatim ((t (:foreground ,green :slant italic))))
   `(org-block ((t (:foreground ,fg1 :background ,bg0 :extend t))))
   `(org-block-begin-line ((t (:foreground ,gray :background ,bg1 :extend t))))
   `(org-block-end-line ((t (:inherit org-block-begin-line))))
   `(org-meta-line ((t (:foreground ,gray :slant italic))))
   `(org-special-keyword ((t (:foreground ,aqua))))
   `(org-property-value ((t (:foreground ,fg2))))
   `(org-date ((t (:foreground ,purple :underline t))))
   `(org-tag ((t (:foreground ,blue :weight normal))))
   `(org-table ((t (:foreground ,blue))))
   `(org-checkbox ((t (:foreground ,orange))))
   `(org-ellipsis ((t (:foreground ,gray :underline nil))))
   `(org-agenda-structure ((t (:foreground ,green :weight bold))))
   `(org-agenda-date ((t (:foreground ,blue))))
   `(org-agenda-date-today ((t (:foreground ,yellow :weight bold))))
   `(org-scheduled ((t (:foreground ,green))))
   `(org-scheduled-today ((t (:foreground ,green))))
   `(org-warning ((t (:foreground ,red :weight bold))))
   `(dired-directory ((t (:foreground ,green :weight bold))))
   `(dired-symlink ((t (:foreground ,aqua))))
   `(dired-executable ((t (:foreground ,yellow))))
   `(dired-marked ((t (:foreground ,purple :weight bold))))
   `(dired-flagged ((t (:foreground ,red :weight bold))))
   `(dashboard-heading ((t (:foreground ,yellow :weight bold))))
   `(dashboard-banner-logo-title ((t (:foreground ,orange :weight bold))))
   `(dashboard-items-face ((t (:foreground ,fg1))))
   `(dashboard-no-items-face ((t (:foreground ,gray))))
   ;; Evil's search overlays do not use the built-in isearch faces.
   `(evil-ex-search ((t (:foreground ,bg0 :background ,yellow))))
   `(evil-ex-lazy-highlight ((t (:foreground ,bg0 :background ,yellow))))
   `(evil-ex-incsearch ((t (:foreground ,bg0 :background ,orange))))
   `(evil-ex-substitute-matches ((t (:foreground ,bg0 :background ,yellow))))
   `(evil-ex-substitute-replacement ((t (:foreground ,green :weight bold)))))

  ;; Match Neovim's 16 terminal colors, including Ghostel's ANSI inheritance.
  (let ((normal (list bg0 "#cc241d" "#98971a" "#d79921"
                      "#458588" "#b16286" "#689d6a" fg4))
        (bright (list gray red green yellow blue purple aqua fg1))
        (names '(black red green yellow blue magenta cyan white)))
    (cl-mapc
     (lambda (name color bright-color)
       (custom-theme-set-faces
        'gruvbox-nvim
        `(,(intern (format "ansi-color-%s" name))
          ((t (:foreground ,color :background ,color))))
        `(,(intern (format "ansi-color-bright-%s" name))
          ((t (:foreground ,bright-color :background ,bright-color))))
        `(,(intern (format "term-color-%s" name))
          ((t (:foreground ,color :background ,color))))))
     names normal bright)
    (custom-theme-set-variables
     'gruvbox-nvim
     `(ansi-color-names-vector [,bg0 "#cc241d" "#98971a" "#d79921"
                               "#458588" "#b16286" "#689d6a" ,fg4])
     `(frame-background-mode 'dark))))

(provide-theme 'gruvbox-nvim)

;;; gruvbox-nvim-theme.el ends here
